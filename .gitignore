# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local Python environments
.venv/
venv/
env/

# PyInstaller and packaged application output
# Keep the checked-in .spec file and build scripts; publish binaries via GitHub Releases.
build/
dist/
*.exe
*.zip

# Runtime logs and generated debug exports
debug/
debug_screenshots/
logs/
*.log
detection_log.txt
bot_console_current_session.txt
MAA-TBH-debug-*.zip

# Screenshots show your game screen, account and inventory. Only the
# recognition templates are tracked; every other image stays local.
*.png
*.jpg
*.jpeg
*.bmp
*.gif
*.webp
!templates/**/*.png

# Temporary/editor/OS files
*.tmp
*.temp
*.bak
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Local Codex / agent instructions
AGENTS*.md
